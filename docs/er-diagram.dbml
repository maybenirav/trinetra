// Trinetra ER diagram. Paste into https://dbdiagram.io to draw it.

Project Trinetra {
  database_type: 'MySQL'
  Note: 'B2B wholesale marketplace: tier pricing, credit buying, payments, stock audit'
}

Table Categories {
  category_id int [pk, increment]
  category_name varchar(60) [unique, not null]
}

Table Suppliers {
  supplier_id int [pk, increment]
  company_name varchar(100) [not null]
  email varchar(100) [unique, not null]
  city varchar(60) [not null]
  gstin char(15) [unique, not null]
  rating decimal(3,2) [not null, default: 5.00, note: '0 to 5']
  created_at datetime [not null]
}

Table Wholesale_Buyers {
  buyer_id int [pk, increment]
  company_name varchar(100) [not null]
  contact_email varchar(100) [unique, not null]
  city varchar(60) [not null]
  gstin char(15) [unique, not null]
  credit_limit decimal(12,2) [not null]
  available_credit decimal(12,2) [not null, note: '0 <= available <= limit']
  created_at datetime [not null]
}

Table Products {
  product_id int [pk, increment]
  supplier_id int [not null]
  category_id int [not null]
  product_name varchar(150) [not null]
  sku varchar(50) [unique, not null]
  unit varchar(20) [not null]
  base_unit_price decimal(10,2) [not null]
  stock_quantity int [not null, note: '>= 0']
  reorder_level int [not null]
}

Table Price_Tiers {
  tier_id int [pk, increment]
  product_id int [not null]
  min_quantity int [not null]
  max_quantity int [note: 'NULL = no upper limit']
  discounted_unit_price decimal(10,2) [not null]
  indexes {
    (product_id, min_quantity) [unique]
  }
}

Table Purchase_Orders {
  order_id int [pk, increment]
  buyer_id int [not null]
  order_date datetime [not null]
  total_amount decimal(12,2) [not null]
  status varchar(20) [not null, note: 'Pending, Approved, Fulfilled, Cancelled']
}

Table Order_Items {
  item_id int [pk, increment]
  order_id int [not null]
  product_id int [not null]
  quantity int [not null]
  applied_unit_price decimal(10,2) [not null, note: 'price snapshot at order time']
  subtotal decimal(12,2) [note: 'generated: quantity x applied_unit_price']
}

Table Payments {
  payment_id int [pk, increment]
  order_id int [not null]
  amount decimal(12,2) [not null]
  payment_mode varchar(10) [not null, note: 'UPI, NEFT, RTGS, Cheque']
  reference_no varchar(40)
  paid_at datetime [not null]
}

Table Stock_Ledger {
  ledger_id int [pk, increment]
  product_id int [not null]
  old_quantity int [not null]
  new_quantity int [not null]
  change_qty int [note: 'generated: new - old']
  reason varchar(100) [not null]
  changed_at datetime [not null]
}

Ref: Suppliers.supplier_id < Products.supplier_id
Ref: Categories.category_id < Products.category_id
Ref: Products.product_id < Price_Tiers.product_id
Ref: Wholesale_Buyers.buyer_id < Purchase_Orders.buyer_id
Ref: Purchase_Orders.order_id < Order_Items.order_id
Ref: Products.product_id < Order_Items.product_id
Ref: Purchase_Orders.order_id < Payments.order_id
Ref: Products.product_id < Stock_Ledger.product_id
